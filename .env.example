# Matchbook v2 — environment template.
# Copy to .env for local dev. Production values live in GitHub Actions secrets
# and are written to /opt/matchbook/.env on the VPS at deploy time.
# Never commit the real .env — it contains API keys and DB credentials.

# --- Database ---------------------------------------------------------------
# Async driver (asyncpg) is used by SQLAlchemy 2.0 because FastAPI is
# async end-to-end; sync drivers would block the event loop.
DATABASE_URL=postgresql+asyncpg://matchbook:matchbook_dev@postgres:5432/matchbook
# Alembic needs a sync URL because migrations run as a one-shot script, not
# inside the FastAPI event loop. Same DB, different driver.
DATABASE_URL_SYNC=postgresql+psycopg2://matchbook:matchbook_dev@postgres:5432/matchbook
POSTGRES_USER=matchbook
POSTGRES_PASSWORD=matchbook_dev
POSTGRES_DB=matchbook

# --- Redis ------------------------------------------------------------------
# Used for token-bucket rate limiting keyed on user_id (not IP — see security).
REDIS_URL=redis://redis:6379/0

# --- JWT (RS256 asymmetric) -------------------------------------------------
# RS256 (public/private) is used instead of HS256 (shared secret) so the public
# key could be distributed to other services without exposing the signing key.
# Generate with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste the PEM contents here with \n preserved, or mount the files as volumes.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Fernet (symmetric encryption at rest for OAuth tokens) -----------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google OAuth (calendar) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Plesk SMTP) -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Matchbook <noreply@tag-art.co.uk>"
# Set false when reaching a local Plesk postfix over the docker bridge
# (self-signed cert, traffic never leaves the host). Leave true for any
# external SMTP provider (SendGrid, Postmark, SES) that presents a real cert.
SMTP_VERIFY_TLS=true

# --- App --------------------------------------------------------------------
# In prod this is the public HTTPS URL; used in verification email links.
FRONTEND_URL=http://localhost:3085
# Comma-separated. CORS rejects anything else. Tightening this prevents
# malicious third-party sites from calling our API with a user's cookies.
CORS_ORIGINS=http://localhost:3085
ENVIRONMENT=development

# --- Stripe billing ---------------------------------------------------------
# Leave empty on dev if you're not working on billing — billing routes will
# return 503 and the rest of the app is unaffected. In prod, all three are
# required for Checkout + webhook to work.
#
# Test-mode keys start with 'sk_test_' / 'whsec_test_' / 'price_'; live-mode
# keys start with 'sk_live_' / 'whsec_'. Stripe CLI for local webhook testing:
#   stripe listen --forward-to http://localhost:3086/api/v1/billing/webhook
# copy the printed `whsec_...` into STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Where Stripe redirects the browser after Checkout. These land in the
# user's address bar — use the public frontend URL in prod.
BILLING_SUCCESS_URL=http://localhost:3085/billing?status=success
BILLING_CANCEL_URL=http://localhost:3085/billing?status=cancel
